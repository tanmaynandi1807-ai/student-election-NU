{
  "name": "nagaon-university-campaign-backend",
  "version": "1.0.0",
  "description": "Backend API for Prince Gogoi's Nagaon University campaign website (Assistant Secretary - Outdoor Sports)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
